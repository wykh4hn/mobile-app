<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared styles. Each one is used in several places on both screens, so a
         change here (size, colour, spacing) updates the whole app at once. -->

    <!-- ===== Text ===== -->
    <style name="KhanhIsDriving.Text.Brand" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="KhanhIsDriving.Text.ScreenTitle" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- "FAVORITES", "MY BOOKING" on the home screen -->
    <style name="KhanhIsDriving.Text.HomeSection" parent="">
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- "1 · RENTER DETAILS" etc. on the booking screen -->
    <style name="KhanhIsDriving.Text.FormSection" parent="">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- Small label above every input: "FULL NAME", "PHONE"... -->
    <style name="KhanhIsDriving.Text.FieldLabel" parent="">
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- "ELECTRIC · 5 SEATS" above the car name -->
    <style name="KhanhIsDriving.Text.Overline" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="KhanhIsDriving.Text.CarTitle" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="KhanhIsDriving.Text.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="KhanhIsDriving.Text.Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Big pink numbers: daily price on the card, total on the booking screen -->
    <style name="KhanhIsDriving.Text.Price" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="KhanhIsDriving.Text.Error" parent="">
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/error</item>
    </style>

    <!-- ===== Boxes ===== -->
    <!-- Pink pill with the credit balance, top of both screens -->
    <style name="KhanhIsDriving.CreditChip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_on_soft</item>
    </style>

    <!-- Read-only value in a soft box (pickup and return dates) -->
    <style name="KhanhIsDriving.InfoBox" parent="">
        <item name="android:background">@drawable/bg_soft_box</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Message shown instead of the car card when nothing can be displayed -->
    <style name="KhanhIsDriving.EmptyBox" parent="KhanhIsDriving.Text.Caption">
        <item name="android:background">@drawable/bg_summary</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">24dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <!-- ===== Widgets (set as defaults in themes.xml or used with style="...") ===== -->
    <style name="Widget.KhanhIsDriving.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.KhanhIsDriving.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/line_strong</item>
    </style>

    <style name="Widget.KhanhIsDriving.Button.Text" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- One half of the Citizen ID / Passport switch -->
    <style name="Widget.KhanhIsDriving.Segment" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">10dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="android:textColor">@color/segment_text</item>
    </style>

    <style name="Widget.KhanhIsDriving.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <!-- The label sits above the box as its own TextView (like the Figma),
             so the EditText hint is used as a placeholder example instead. -->
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/bg_card</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.KhanhIsDriving.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="ShapeAppearance.KhanhIsDriving.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
