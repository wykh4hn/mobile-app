<?xml version="1.0" encoding="utf-8"?>
<!-- Booking screen (Figma "booking"). Three numbered sections, a live price summary,
     then Cancel / Save. Every input has its own label above it, like the design. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical"
    tools:context=".BookingActivity">

    <ScrollView
        android:id="@+id/scrollBooking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- ===== Top bar: Back, balance, dark-mode switch ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.KhanhIsDriving.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txtBalance"
                    style="@style/KhanhIsDriving.CreditChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="500 credits" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swDarkMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/cd_dark_mode" />
            </LinearLayout>

            <!-- ===== Details of the car received through the Intent (Parcelable) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_soft_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgCar"
                    android:layout_width="96dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.KhanhIsDriving.Rounded"
                    tools:ignore="ContentDescription"
                    tools:src="@drawable/car_corolla" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtCategory"
                        style="@style/KhanhIsDriving.Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Sedan · 5 seats" />

                    <TextView
                        android:id="@+id/txtCarName"
                        style="@style/KhanhIsDriving.Text.CarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Toyota Corolla" />

                    <TextView
                        android:id="@+id/txtCarMeta"
                        style="@style/KhanhIsDriving.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="2021 · 45 cr/day" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RatingBar
                            android:id="@+id/ratingBar"
                            style="@style/Widget.AppCompat.RatingBar.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressBackgroundTint="@color/dot_off"
                            android:progressTint="@color/accent"
                            android:stepSize="0.1"
                            tools:rating="4.5" />

                        <TextView
                            android:id="@+id/txtCarDetails"
                            style="@style/KhanhIsDriving.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            tools:text="4.5 · 32,000 km" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 1 · Renter details ===== -->
            <TextView
                style="@style/KhanhIsDriving.Text.FormSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_renter" />

            <TextView
                style="@style/KhanhIsDriving.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etName"
                android:text="@string/label_full_name" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:hint="@string/hint_full_name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KhanhIsDriving.Text.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/etPhone"
                        android:text="@string/label_phone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="phone"
                            android:hint="@string/hint_phone"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:maxLength="10" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KhanhIsDriving.Text.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/etEmail"
                        android:text="@string/label_email" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:hint="@string/hint_email"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/KhanhIsDriving.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etAddress"
                android:text="@string/label_address" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="postalAddress"
                    android:gravity="top|start"
                    android:hint="@string/hint_address"
                    android:inputType="textPostalAddress|textMultiLine|textCapWords"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== 2 · Identification ===== -->
            <TextView
                style="@style/KhanhIsDriving.Text.FormSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_id" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleIdType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:checkedButton="@id/btnCitizenId"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCitizenId"
                    style="@style/Widget.KhanhIsDriving.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/citizen_id" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPassport"
                    style="@style/Widget.KhanhIsDriving.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/passport" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Label text changes with the toggle above (set in code) -->
            <TextView
                android:id="@+id/txtIdLabel"
                style="@style/KhanhIsDriving.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etIdNumber"
                android:text="@string/label_citizen_id" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilIdNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etIdNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_citizen_id"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/KhanhIsDriving.Text.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@id/etLicence"
                android:text="@string/label_licence" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLicence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLicence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_licence"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="12" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== 3 · Rental period ===== -->
            <TextView
                style="@style/KhanhIsDriving.Text.FormSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_period" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KhanhIsDriving.Text.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_pickup" />

                    <TextView
                        android:id="@+id/txtPickupDate"
                        style="@style/KhanhIsDriving.InfoBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Nov 8, 2026" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/KhanhIsDriving.Text.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_return" />

                    <TextView
                        android:id="@+id/txtReturnDate"
                        style="@style/KhanhIsDriving.InfoBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Nov 9, 2026" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    style="@style/KhanhIsDriving.Text.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/sliderDays"
                    android:text="@string/label_days" />

                <TextView
                    android:id="@+id/txtDaysValue"
                    style="@style/KhanhIsDriving.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:textStyle="bold"
                    tools:text="1 day" />
            </LinearLayout>

            <!-- Number of days: a Slider from 1 to 7 (second non-TextView widget) -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_days_slider"
                android:stepSize="1"
                android:value="1"
                android:valueFrom="1"
                android:valueTo="7" />

            <!-- ===== Live price summary ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_summary"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtCostLine"
                        style="@style/KhanhIsDriving.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="45 cr × 1 day" />

                    <TextView
                        android:id="@+id/txtCostValue"
                        style="@style/KhanhIsDriving.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        tools:text="45 cr" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KhanhIsDriving.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_balance_after" />

                    <TextView
                        android:id="@+id/txtBalanceAfter"
                        style="@style/KhanhIsDriving.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="455 cr" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/KhanhIsDriving.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_total"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTotal"
                        style="@style/KhanhIsDriving.Text.Price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        tools:text="45 credits" />
                </LinearLayout>

                <!-- Credit rule broken (over 400, or more than the balance) -->
                <TextView
                    android:id="@+id/txtCreditError"
                    style="@style/KhanhIsDriving.Text.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone"
                    tools:text="One rental can't cost more than 400 credits."
                    tools:visibility="visible" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/terms"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/txtTermsError"
                style="@style/KhanhIsDriving.Text.Error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/error_terms"
                android:visibility="gone" />

            <!-- Summary of everything still wrong when Save is pressed -->
            <TextView
                android:id="@+id/txtFormError"
                style="@style/KhanhIsDriving.Text.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="3 items above need fixing before you can save."
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.KhanhIsDriving.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.6"
                    android:text="@string/save_booking" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>