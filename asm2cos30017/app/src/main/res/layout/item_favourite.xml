<?xml version="1.0" encoding="utf-8"?>
<!-- One favourite car in the horizontal list. Tapping it shows that car on the main card. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgFavCar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            tools:src="@drawable/car_tesla" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/txtFavName"
                style="@style/KhanhIsDriving.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="bold"
                tools:text="Tesla Model 3" />

            <TextView
                android:id="@+id/txtFavStatus"
                style="@style/KhanhIsDriving.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="70 credits/day" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>