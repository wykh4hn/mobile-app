<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/star"
        android:contentDescription="@string/desc_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/title"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/imgLogo"
        app:layout_constraintTop_toTopOf="@id/imgLogo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogo" />

    <Button
        android:id="@+id/btnLang"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="20dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="0dp"
        android:text="@string/btn_lang"
        android:textColor="@color/btn_secondary_text"
        android:textSize="11sp"
        android:textStyle="bold"
        app:strokeColor="@color/border_soft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgLogo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogo" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideMid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.46" />

    <LinearLayout
        android:id="@+id/cardScore"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/background_card"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideMid"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_score"
            android:textColor="@color/text_disabled"
            android:textSize="11sp"
            android:letterSpacing="0.15" />

        <TextView
            android:id="@+id/txtScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtZone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtElement"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toEndOf="@id/guideMid"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/barProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="10"
        android:progress="0"
        android:progressTint="@color/btn_primary"
        android:progressBackgroundTint="@color/btn_secondary"
        app:layout_constraintTop_toBottomOf="@id/txtElement"
        app:layout_constraintStart_toStartOf="@id/txtElement"
        app:layout_constraintEnd_toEndOf="@id/txtElement" />

    <TextView
        android:id="@+id/txtMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="36dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/barProgress"
        app:layout_constraintStart_toStartOf="@id/txtElement"
        app:layout_constraintEnd_toEndOf="@id/txtElement" />

    <LinearLayout
        android:id="@+id/rowButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/txtElement"
        app:layout_constraintEnd_toEndOf="@id/txtElement">

        <Button
            android:id="@+id/btnDeduction"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_deduction"
            android:textSize="13sp"
            android:backgroundTint="@color/btn_secondary"
            android:textColor="@color/btn_secondary_text"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="@string/btn_reset"
            android:textSize="13sp"
            android:backgroundTint="@color/btn_secondary"
            android:textColor="@color/btn_secondary_text"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPerform"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="8dp"
        android:text="@string/btn_perform"
        android:textSize="15sp"
        android:backgroundTint="@color/btn_primary"
        android:textColor="@color/btn_primary_text"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/rowButtons"
        app:layout_constraintStart_toStartOf="@id/txtElement"
        app:layout_constraintEnd_toEndOf="@id/txtElement" />

</androidx.constraintlayout.widget.ConstraintLayout>